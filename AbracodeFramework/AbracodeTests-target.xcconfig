
PRODUCT_BUNDLE_IDENTIFIER = com.abracode.AbracodeTests
PRODUCT_NAME = $(TARGET_NAME)

// Common/ holds shared header-only code (e.g. OMCEngineTempDir.h) that unit tests compile
// directly. It is not on the test target's default header map, so add it explicitly.
// ThirdParty/yyjson: the JSON parity tests compile Common/ACFJSON.cpp, which includes yyjson.h.
USER_HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/../Common $(SRCROOT)/../Common/Apple $(SRCROOT)/../ThirdParty/yyjson

ENABLE_TESTABILITY[config=Debug] = YES
GENERATE_INFOPLIST_FILE = YES

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Nib dialogs: see OMC_NIB_DIALOGS in OmcProjectCommon.xcconfig. Their tests go with them.
OMC_NIB_DIALOGS_EXCLUDED_YES =
OMC_NIB_DIALOGS_EXCLUDED_NO = OMCNibDialogTests.m
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(OMC_NIB_DIALOGS_EXCLUDED_$(OMC_NIB_DIALOGS))
