{
  "VERSION": 2,
  "COMMAND_LIST": [
    { "NAME": "LaunchTest", "ACTIVATION_MODE": "act_always", "EXECUTION_MODE": "exe_script_file" },
    { "NAME": "LaunchTest", "COMMAND_ID": "app.did.launch", "EXECUTION_MODE": "exe_script_file" },
    { "NAME": "LaunchTest", "COMMAND_ID": "app.will.terminate", "EXECUTION_MODE": "exe_script_file" },
    { "NAME": "LaunchTest", "COMMAND_ID": "omc.app.handle-url", "EXECUTION_MODE": "exe_script_file" },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.window", "ACTIVATION_MODE": "act_always", "EXECUTION_MODE": "exe_script_file",
      "URL_INVOCABLE": true,
      "ACTIONUI_WINDOW": { "JSON_NAME": "Window", "IS_BLOCKING": false,
                           "INIT_SUBCOMMAND_ID": "lt.window.init", "END_OK_SUBCOMMAND_ID": "lt.window.ok" } },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.window.init", "EXECUTION_MODE": "exe_script_file" },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.modal", "ACTIVATION_MODE": "act_always", "EXECUTION_MODE": "exe_script_file",
      "URL_INVOCABLE": true,
      "ACTIONUI_WINDOW": { "JSON_NAME": "Window", "IS_BLOCKING": true, "INIT_SUBCOMMAND_ID": "lt.modal.init" } },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.modal.init", "EXECUTION_MODE": "exe_script_file" },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.input", "ACTIVATION_MODE": "act_always", "EXECUTION_MODE": "exe_shell_script",
      "URL_INVOCABLE": true, "INPUT_DIALOG": { "INPUT_TYPE": "input_clear_text", "MESSAGE": "Write something" },
      "COMMAND": ["printf 'input:%s\\n' __INPUT_TEXT__ >> \"$LAUNCHTEST_LOG\""] },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.macos", "ACTIVATION_MODE": "act_always", "EXECUTION_MODE": "exe_script_file",
      "URL_INVOCABLE": true, "REQUIRED_MAC_OS_MIN_VERSION": "99.0", "REQUIRED_MAC_OS_MAX_VERSION": "10.1" },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.window.ok", "EXECUTION_MODE": "exe_script_file",
      "ENVIRONMENT_VARIABLES": { "OMC_ACTIONUI_VIEW_2_VALUE": "" } },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.shell", "ACTIVATION_MODE": "act_always", "EXECUTION_MODE": "exe_shell_script",
      "URL_INVOCABLE": true, "NEXT_COMMAND_ID": "lt.shell.script",
      "COMMAND": ["if [[ -n \"$BASH_VERSION\" ]]; then printf 'shell.command.bash\\n' >> \"$LAUNCHTEST_LOG\"; fi"] },
    { "NAME": "LaunchTest", "COMMAND_ID": "lt.shell.script", "EXECUTION_MODE": "exe_script_file" }
  ]
}
