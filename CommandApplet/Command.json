{
  "COMMAND_LIST": [
    {
      "COMMAND": [
        "echo \"Welcome to Command Workshop\""
      ],
      "END_NOTIFICATION": {},
      "NAME": "Welcome",
      "REQUIRED_MAC_OS_MIN_VERSION": "14.6",
      "REQUIRED_OMC_VERSION": "5.0",
      "VERSION": 1
    },
    {
      "COMMAND_ID": "app.will.launch",
      "EXECUTION_MODE": "exe_script_file",
      "WAIT_FOR_TASK_COMPLETION": true,
      "NAME": "CommandApplet"
    },
    {
      "COMMAND_ID": "app.did.launch",
      "EXECUTION_MODE": "exe_script_file",
      "WAIT_FOR_TASK_COMPLETION": true,
      "NAME": "CommandApplet"
    },
    {
      "COMMAND_ID": "app.will.terminate",
      "EXECUTION_MODE": "exe_script_file",
      "WAIT_FOR_TASK_COMPLETION": true,
      "NAME": "CommandApplet"
    },
    {
      "COMMAND": [
        "env | sort\necho \"OMC_ACTIONUI_WINDOW_UUID = ${OMC_ACTIONUI_WINDOW_UUID}\"\n\t\t\t\t"
      ],
      "EXECUTION_MODE": "exe_shell_script",
      "NAME": "Form",
      "ACTIONUI_WINDOW": {
        "INIT_SUBCOMMAND_ID": "form.dialog.init",
        "END_OK_SUBCOMMAND_ID": "form.save",
        "END_CANCEL_SUBCOMMAND_ID": "form.cancel",
        "IS_BLOCKING": false,
        "JSON_NAME": "Form"
      },
      "NOTES": "ActionUI json window test",
      "REQUIRED_MAC_OS_MIN_VERSION": "14.6",
      "REQUIRED_OMC_VERSION": "5.0",
      "VERSION": 1
    },
    {
      "COMMAND": [
        "echo \"form.dialog.init\"\nenv | sort\necho \"------------------\"\ndialog_tool=\"$OMC_OMC_SUPPORT_PATH/omc_dialog_control\"\necho \"$dialog_tool \\\"$OMC_ACTIONUI_WINDOW_UUID\\\" 2 \\\"Papa Smurf\\\"\"\n\"$dialog_tool\" \"$OMC_ACTIONUI_WINDOW_UUID\" 2 \"Papa Smurf\"\n# hide password \n\"$dialog_tool\" \"$OMC_ACTIONUI_WINDOW_UUID\" 3 omc_set_property \"hidden\" true\n# disable \"Save\" button \n\"$dialog_tool\" \"$OMC_ACTIONUI_WINDOW_UUID\" 7 omc_set_property \"disabled\" true\n\n# uncomment the line below to show the window with environment variables\n# \"$OMC_OMC_SUPPORT_PATH/omc_next_command\" \"$OMC_CURRENT_COMMAND_GUID\" \"form.dialog.show.env\"\n\t\t\t\t"
      ],
      "COMMAND_ID": "form.dialog.init",
      "EXECUTION_MODE": "exe_shell_script",
      "NAME": "Form"
    },
    {
      "COMMAND": [
        "env | sort"
      ],
      "COMMAND_ID": "form.dialog.show.env",
      "EXECUTION_MODE": "exe_shell_script_with_output_window",
      "NAME": "Form",
      "OUTPUT_WINDOW_SETTINGS": {
        "TEXT_FONT": "Monaco",
        "TEXT_SIZE": 10,
        "WINDOW_HEIGHT": 600,
        "WINDOW_POSITION": "alert",
        "WINDOW_TYPE": "floating",
        "WINDOW_WIDTH": 900
      },
      "ENVIRONMENT_VARIABLES": {
        "CUSTOM_VAR": "form"
      }
    },
    {
      "COMMAND": [
        "env | sort\necho \"form.save: name=${OMC_ACTIONUI_VIEW_2_VALUE}\"\n\t\t\t\t"
      ],
      "COMMAND_ID": "form.save",
      "EXECUTION_MODE": "exe_shell_script_with_output_window",
      "NAME": "Form"
    },
    {
      "COMMAND": [
        "env | sort\necho \"form.cancel\"\n\t\t\t\t"
      ],
      "COMMAND_ID": "form.cancel",
      "EXECUTION_MODE": "exe_shell_script_with_output_window",
      "NAME": "Form"
    },
    {
      "ACTIVATION_MODE": "act_selected_text",
      "COMMAND": [
        "WINDOW_UUID=\"${OMC_OBJ_TEXT}\"\nif [ -n \"${WINDOW_UUID}\" ]; then\n    \"$OMC_OMC_SUPPORT_PATH/omc_dialog_control\" \"$WINDOW_UUID\" omc_window omc_terminate_cancel\nfi\nenv | sort\n\t\t\t\t"
      ],
      "COMMAND_ID": "form.close.window",
      "EXECUTION_MODE": "exe_shell_script",
      "NAME": "Form",
      "NOTES": "Test command designed to receive OMC_ACTIONUI_WINDOW_UUID from text context"
    }
  ],
  "VERSION": 2
}
